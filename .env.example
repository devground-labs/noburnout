# Visitor counter (api/visitors.go). Set these in Vercel -> Project Settings -> Environment Variables.
# Required: a Redis connection string (redis:// or rediss://). Upstash, Redis Cloud, etc. all work.
REDIS_URL=rediss://default:password@host:6379
# Optional: secret used to hash visitor IPs (defaults to a hash of REDIS_URL).
VISITOR_SALT=
# Optional: extra hostnames allowed to count visitors (same-origin is always allowed).
ALLOWED_HOSTS=
